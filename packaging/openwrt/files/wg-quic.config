# Each enabled instance is supervised by procd at boot. The section name is
# used as the interface name unless option name is set explicitly.
#
# config instance 'aws'
#	option enabled '1'
#	option config '/etc/wg-quic/aws.conf'
#	# Compatibility fallback for vendor kernels that emit malformed TUN GSO
#	# metadata. This trades throughput for a non-offloaded packet path.
#	option disable_tun_offload '1'
