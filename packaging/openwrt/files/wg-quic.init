#!/bin/sh /etc/rc.common
# shellcheck shell=sh disable=SC2034,SC3043

START=90
STOP=10
USE_PROCD=1

WG_QUIC_QUICK=/usr/bin/wg-quic-quick
WG_QUIC_CONFIG_PACKAGE=wg-quic
WG_QUIC_CONFIG_DIR=/etc/wg-quic

requested_instance=
matched_instance=0

valid_interface_name()
{
	case "$1" in
		''|*[!A-Za-z0-9_=+.-]*|????????????????*) return 1 ;;
		*) return 0 ;;
	esac
}

start_wg_quic_instance()
{
	local name="$1"
	local config="$2"

	if ! valid_interface_name "$name"; then
		logger -t wg-quic "refusing invalid interface name: $name"
		return 1
	fi
	if [ ! -r "$config" ]; then
		logger -t wg-quic "configuration is not readable: $config"
		return 1
	fi

	procd_open_instance "$name"
	procd_set_param command "$WG_QUIC_QUICK" run "$config" --name "$name"
	procd_set_param file "$config"
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 25
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_configured_instance()
{
	local section="$1"
	local name enabled config

	config_get name "$section" name "$section"
	if [ -n "$requested_instance" ] &&
		[ "$requested_instance" != "$name" ] &&
		[ "$requested_instance" != "$section" ]; then
		return 0
	fi

	matched_instance=1
	config_get_bool enabled "$section" enabled 0
	[ -n "$requested_instance" ] || [ "$enabled" -eq 1 ] || return 0
	config_get config "$section" config "$WG_QUIC_CONFIG_DIR/$name.conf"
	start_wg_quic_instance "$name" "$config"
}

start_service()
{
	requested_instance="${1:-}"
	matched_instance=0
	config_load "$WG_QUIC_CONFIG_PACKAGE"
	config_foreach start_configured_instance instance

	# A manual `wg-quic-quick up NAME` also works for a conventional
	# /etc/wg-quic/NAME.conf without requiring a UCI section. UCI remains the
	# source for boot-time instances and the future LuCI integration.
	if [ -n "$requested_instance" ] && [ "$matched_instance" -eq 0 ]; then
		start_wg_quic_instance \
			"$requested_instance" \
			"$WG_QUIC_CONFIG_DIR/$requested_instance.conf"
	fi
}

service_triggers()
{
	procd_add_reload_trigger "$WG_QUIC_CONFIG_PACKAGE"
}
