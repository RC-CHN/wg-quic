{
  "name": "wg-quic-desktop",
  "productName": "wg-quic",
  "version": "0.2.3",
  "description": "Desktop shell for wg-quic-quick",
  "private": true,
  "type": "module",
  "os": [
    "linux",
    "win32"
  ],
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "clean": "node scripts/clean-output.mjs",
    "version:check": "node scripts/check-version.mjs",
    "native": "npm run version:check && node scripts/prepare-native.mjs",
    "dev": "vite",
    "start": "npm run native && tauri dev",
    "build:web": "vite build",
    "check": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "smoke:native": "node scripts/smoke-native.mjs",
    "smoke:app": "node scripts/smoke-app.mjs",
    "package": "npm run clean && npm run native && tauri build --no-bundle",
    "make": "npm run clean && npm run native && tauri build",
    "tauri": "tauri",
    "verify": "npm run check && npm test && npm run package && npm run smoke:native"
  },
  "author": {
    "name": "RC-CHN"
  },
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2"
  }
}
